# Copy this file to .env.local and fill in your values.
# Never commit .env.local to GitHub.

# Google AI Studio -> Get API key (one key per team)
GEMINI_API_KEY=

# Gemini model name. Use the model your trainer gives you.
GEMINI_MODEL=gemini-3.5-flash-lite

# Supabase -> Project Settings -> Project URL
SUPABASE_URL=

# Supabase -> Project Settings -> API Keys -> secret key (service_role)
# Server only. Never use this in frontend code.
SUPABASE_SECRET_KEY=

# Private random session-signing secret. Never share this value.
APP_PASSCODE=

# Shared sign-in passcode for workshop visitors.
DEMO_PASSCODE=
